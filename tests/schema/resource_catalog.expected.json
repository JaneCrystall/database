        },
        {
          "name": "kb_resource_entries_external_key_check",
          "type": "c",
          "validated": true,
          "definition": "CHECK (length(external_key) >= 1 AND length(external_key) <= 1024)"
        },
        {
          "name": "kb_resource_entries_field_provenance_check",
          "type": "c",
          "validated": true,
          "definition": "CHECK (jsonb_typeof(field_provenance) = 'object'::text)"
        },
        {
          "name": "kb_resource_entries_manual_overrides_check",
          "type": "c",
          "validated": true,
          "definition": "CHECK (jsonb_typeof(manual_overrides) = 'object'::text)"
        },
        {
          "name": "kb_resource_entries_metadata_mode_check",
          "type": "c",
          "validated": true,
          "definition": "CHECK (metadata_mode = ANY (ARRAY['managed'::text, 'legacy_ref'::text]))"
        },
        {
          "name": "kb_resource_entries_pkey",
          "type": "p",
          "validated": true,
          "definition": "PRIMARY KEY (id)"
        },
        {
          "name": "kb_resource_entries_primary_source_binding_id_check",
          "type": "c",
          "validated": true,
          "definition": "CHECK (length(primary_source_binding_id) >= 1 AND length(primary_source_binding_id) <= 128)"
        },
        {
          "name": "kb_resource_entries_profile_json_check",
          "type": "c",
          "validated": true,
          "definition": "CHECK (jsonb_typeof(profile_json) = 'object'::text)"
        },
        {
          "name": "kb_resource_entries_review_state_check",
          "type": "c",
          "validated": true,
          "definition": "CHECK (review_state = ANY (ARRAY['pending'::text, 'approved'::text, 'rejected'::text, 'conflict'::text]))"
        },
        {
          "name": "kb_resource_entries_revision_check",
