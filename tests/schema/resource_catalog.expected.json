        },
        {
          "name": "kb_resource_entries_check",
          "type": "c",
          "validated": true,
          "definition": "CHECK (metadata_mode = 'managed'::text AND legacy_ref IS NULL OR metadata_mode = 'legacy_ref'::text AND jsonb_typeof(legacy_ref) = 'object'::text AND legacy_ref IS NOT NULL)"
        },
        {
          "name": "kb_resource_entries_check1",
          "type": "c",
          "validated": true,
          "definition": "CHECK ((octet_length(source_metadata::text) + octet_length(manual_overrides::text) + octet_length(field_provenance::text) + octet_length(candidates::text)) <= 65536)"
        },
        {
          "name": "kb_resource_entries_check2",
          "type": "c",
          "validated": true,
          "definition": "CHECK (review_state = 'approved'::text AND approved_revision IS NOT NULL AND approved_revision <= revision AND approved_candidate_id IS NOT NULL AND approved_sha256 IS NOT NULL AND approved_size IS NOT NULL AND approved_sha256 ~ '^[0-9a-f]{64}$'::text AND approved_size > 0 AND approved_by IS NOT NULL AND approved_at IS NOT NULL OR review_state <> 'approved'::text AND approved_revision IS NULL AND approved_candidate_id IS NULL AND approved_sha256 IS NULL AND approved_size IS NULL AND approved_by IS NULL AND approved_at IS NULL)"
        },
        {
          "name": "kb_resource_entries_collection_id_fkey",
